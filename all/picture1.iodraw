<mxfile host="app.diagrams.net">
  <diagram name="AD-DDPG Framework">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Environment -->
        <mxCell id="env" value="环境 (Env)\nUAV + Pursuers + Map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Actor -->
        <mxCell id="actor" value="Actor 网络\nμ(s|θ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Interaction -->
        <mxCell id="interact" value="环境交互\n(s,a,r,s')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Replay -->
        <mxCell id="replay" value="经验回放池\nReplay Buffer" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- FGSM -->
        <mxCell id="fgsm" value="对抗样本生成\nFGSM\ns_adv = s + ε sign(∇Q)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Critic -->
        <mxCell id="critic" value="Critic 网络更新\nQ(s,a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Actor update -->
        <mxCell id="actor_update" value="Actor 网络更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell edge="1" parent="1" source="env" target="actor">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" parent="1" source="actor" target="interact">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" parent="1" source="interact" target="replay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" parent="1" source="replay" target="fgsm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" parent="1" source="fgsm" target="critic">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" parent="1" source="critic" target="actor_update">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>